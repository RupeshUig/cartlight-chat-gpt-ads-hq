// Cartlight Labs — Prisma Schema
// Provider configured for SQLite in local development
// Ready for seamless migration to PostgreSQL in production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Shopify Authentication Session Storage
// Required by @shopify/shopify-app-session-storage-prisma
// -------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// -------------------------------------------------------------
// Core Domain: Shop
// Represents an installed Shopify merchant store
// -------------------------------------------------------------
model Shop {
  id               String            @id @default(cuid())
  shopifyDomain    String            @unique
  shopifyShopId    String?
  name             String?
  email            String?
  currency         String            @default("USD")
  country          String?
  ianaTimezone     String            @default("UTC")
  installedAt      DateTime          @default(now())
  uninstalledAt    DateTime?
  lastConnectedAt  DateTime          @default(now())
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  products         Product[]
  openAIConnection OpenAIConnection?
  syncRuns         SyncRun[]
  dailyInsights    DailyInsight[]
  alerts           Alert[]
  spendRules       SpendRule[]
  auditLogs        AuditLog[]

  @@index([shopifyDomain])
  @@index([shopifyShopId])
  @@index([isActive])
}

// -------------------------------------------------------------
// Product Catalog, Cost of Goods (COGS), & Sync State
// -------------------------------------------------------------
model Product {
  id                String           @id @default(cuid())
  shopId            String
  shopifyProductId  String
  title             String
  handle            String?
  status            String           @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  vendor            String?
  productType       String?
  totalInventory    Int              @default(0)
  isSyncedToChatGPT Boolean          @default(false)
  chatGPTSyncStatus String           @default("PENDING") // PENDING, SYNCED, FAILED, EXCLUDED
  lastSyncedAt      DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  shop              Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId])
  @@index([status])
  @@index([chatGPTSyncStatus])
}

model ProductVariant {
  id                     String   @id @default(cuid())
  productId              String
  shopifyVariantId       String
  shopifyInventoryItemId String?
  title                  String
  sku                    String?
  price                  Float    @default(0.0)
  compareAtPrice         Float?
  cost                   Float?   // Unit cost (COGS) from Shopify InventoryItem
  inventoryQuantity      Int      @default(0)
  barcode                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, shopifyVariantId])
  @@index([productId])
  @@index([sku])
  @@index([shopifyInventoryItemId])
}

// -------------------------------------------------------------
// OpenAI Ads Connection & Credentials at Rest
// -------------------------------------------------------------
model OpenAIConnection {
  id              String    @id @default(cuid())
  shopId          String    @unique
  organizationId  String?
  accountId       String?
  encryptedApiKey String?   // AES-256-GCM encrypted API key at rest
  keyPreview      String?   // Masked preview string for UI (e.g. sk-proj-...4f8b)
  status          String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR, PENDING
  lastConnectedAt DateTime?
  lastSyncAt      DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
}

// -------------------------------------------------------------
// Sync & Telemetry Pipeline
// -------------------------------------------------------------
model SyncRun {
  id             String    @id @default(cuid())
  shopId         String
  syncType       String    // PRODUCTS, METRICS, CAMPAIGNS, FULL
  status         String    @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED, PARTIAL
  itemsTotal     Int       @default(0)
  itemsProcessed Int       @default(0)
  itemsFailed    Int       @default(0)
  errorMessage   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([startedAt])
}

// -------------------------------------------------------------
// Performance & Profitability Insights
// Supports multi-level reporting: SHOP, CAMPAIGN, AD_GROUP, AD, PRODUCT
// -------------------------------------------------------------
model DailyInsight {
  id              String   @id @default(cuid())
  shopId          String
  date            DateTime
  granularity     String   @default("SHOP") // SHOP, CAMPAIGN, AD_GROUP, AD, PRODUCT
  entityId        String   @default("SHOP") // "SHOP", campaignId, adGroupId, adId, or productId
  campaignId      String?
  campaignName    String?
  adGroupId       String?
  adGroupName     String?
  adId            String?
  adName          String?
  productId       String?
  variantId       String?
  adSpend         Float    @default(0.0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Int      @default(0)
  conversionValue Float    @default(0.0)
  roas            Float    @default(0.0)
  cpa             Float    @default(0.0)
  grossProfit     Float    @default(0.0)
  netProfit       Float    @default(0.0)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date, granularity, entityId])
  @@index([shopId, granularity])
  @@index([campaignId])
  @@index([productId])
  @@index([date])
}

// -------------------------------------------------------------
// Operational Alerts & Notifications
// -------------------------------------------------------------
model Alert {
  id          String    @id @default(cuid())
  shopId      String
  title       String
  message     String
  severity    String    @default("INFO") // INFO, WARNING, CRITICAL
  type        String    // BUDGET_EXCEEDED, SYNC_FAILURE, DISCONNECTED_ACCOUNT, ANOMALY, GENERAL
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
}

// -------------------------------------------------------------
// Automated Spend & Budget Guardrails
// -------------------------------------------------------------
model SpendRule {
  id              String    @id @default(cuid())
  shopId          String
  name            String
  description     String?
  isActive        Boolean   @default(true)
  ruleType        String    // MAX_DAILY_SPEND, TARGET_ROAS, MIN_MARGIN_STOP, ANOMALY_PAUSE
  conditions      String    // Serialized JSON for portable cross-database storage
  actions         String    // Serialized JSON for portable cross-database storage
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([isActive])
}

// -------------------------------------------------------------
// Security & Compliance Audit Log
// -------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  shopId     String
  actor      String   // SYSTEM, USER, SHOPIFY_WEBHOOK, OPENAI_SYNC
  action     String   // e.g., "CONNECTION_UPDATED", "RULE_TRIGGERED"
  entityType String?
  entityId   String?
  details    String?  // Contextual JSON or summary
  ipAddress  String?
  createdAt  DateTime @default(now())

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([action])
  @@index([createdAt])
}
